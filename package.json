{
	"name": "svelte-music-player",
	"version": "0.0.4",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build && npm run package",
		"preview": "vp preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "vp fmt ./src",
		"lint": "vp fmt --check ./src && vp lint ./src",
		"prepare": "vp config"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/MusicPlayer/assets/test.mp3"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"publint": "^0.3.25",
		"svelte": "^5.57.2",
		"svelte-check": "^4.3.4",
		"typescript": "^6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
		"vite-plus": "1.3.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
	}
}
